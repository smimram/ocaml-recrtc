# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "WebRTC transport stack in OCaml"
description: """
The pieces a WebRTC endpoint is made of, none of which exists in opam:
SDP, ICE and STUN, DTLS with the SRTP key exchange, SRTP itself, RTP with
the VP8, VP9 and H.264 payload formats, and Ogg/Opus and Matroska muxers
which store a peer's packets bit-exact."""
maintainer: ["Samuel Mimram <smimram@gmail.com>"]
authors: ["Samuel Mimram <smimram@gmail.com>"]
license: "LGPL-2.1-or-later"
homepage: "https://github.com/smimram/ocaml-webrtc"
bug-reports: "https://github.com/smimram/ocaml-webrtc/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14"}
  "digestif"
  "ipaddr"
  "mirage-crypto"
  "mirage-crypto-ec"
  "mirage-crypto-rng" {>= "1.0.0"}
  "ptime"
  "tls"
  "x509"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/smimram/ocaml-webrtc.git"
