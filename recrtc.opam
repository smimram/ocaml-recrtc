# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Record what a browser sends over WebRTC as an Ogg/Opus file"
description: """
A web server which records the audio a browser sends it over WebRTC. The
WebRTC stack it needs is implemented here, in OCaml: SDP, ICE and STUN,
DTLS with the SRTP key exchange, SRTP itself, and an Ogg/Opus muxer which
stores the browser's packets bit-exact."""
maintainer: ["Samuel Mimram <smimram@gmail.com>"]
authors: ["Samuel Mimram <smimram@gmail.com>"]
license: "LGPL-2.1-or-later"
homepage: "https://github.com/smimram/ocaml-recrtc"
bug-reports: "https://github.com/smimram/ocaml-recrtc/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14"}
  "dream"
  "digestif"
  "ipaddr"
  "lwt"
  "lwt_ppx"
  "mirage-crypto"
  "mirage-crypto-ec"
  "mirage-crypto-rng" {>= "1.0.0"}
  "ptime"
  "tls"
  "x509"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/smimram/ocaml-recrtc.git"
